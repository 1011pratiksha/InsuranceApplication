  "components": {
    "schemas": {
      "CreateClaimDocumentDto": {
        "required": [
          "documentName"
        ],
        "type": "object",
        "properties": {
          "documentName": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "filePath": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateClaimDto": {
        "required": [
          "claimType"
        ],
        "type": "object",
        "properties": {
          "policyId": {
            "minimum": 1,
            "type": "integer",
            "format": "int64"
          },
          "customerId": {
            "minimum": 1,
            "type": "integer",
            "format": "int64"
          },
          "claimType": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "incidentDate": {
            "type": "string",
            "format": "date-time"
          },
          "estimatedLoss": {
            "maximum": 999999999999999,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateSurveyDto": {
        "type": "object",
        "properties": {
          "surveyorId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "inspectionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SurveyReportDto": {
        "required": [
          "remarks"
        ],
        "type": "object",
        "properties": {
          "inspectionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "reportPath": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "remarks": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdateClaimDto": {
        "required": [
          "claimType"
        ],
        "type": "object",
        "properties": {
          "claimType": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "incidentDate": {
            "type": "string",
            "format": "date-time"
          },
          "estimatedLoss": {
            "maximum": 999999999999999,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
