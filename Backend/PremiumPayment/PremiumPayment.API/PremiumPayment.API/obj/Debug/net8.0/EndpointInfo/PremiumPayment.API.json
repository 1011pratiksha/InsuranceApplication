  "components": {
    "schemas": {
      "ApproveRefundDto": {
        "required": [
          "approved_by"
        ],
        "type": "object",
        "properties": {
          "approved_by": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "CreatePaymentDto": {
        "required": [
          "payment_mode",
          "schedule_id"
        ],
        "type": "object",
        "properties": {
          "schedule_id": {
            "type": "integer",
            "format": "int64"
          },
          "payment_mode": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateRefundDto": {
        "required": [
          "payment_id",
          "refund_amount"
        ],
        "type": "object",
        "properties": {
          "payment_id": {
            "type": "integer",
            "format": "int64"
          },
          "refund_amount": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "VerifyRazorpayPaymentDto": {
        "required": [
          "payment_id",
          "razorpay_order_id",
          "razorpay_payment_id",
          "razorpay_signature"
        ],
        "type": "object",
        "properties": {
          "payment_id": {
            "type": "integer",
            "format": "int64"
          },
          "razorpay_order_id": {
            "minLength": 1,
            "type": "string"
          },
          "razorpay_payment_id": {
            "minLength": 1,
            "type": "string"
          },
          "razorpay_signature": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
